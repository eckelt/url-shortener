{
  "schemaVersion": 4,
  "system": {
    "id": "url-shortener",
    "name": "url-shortener",
    "summary": "Damit Links in Mails, Folien und Posts kurz bleiben: ecke.lt/~{code} leitet auf die Ziel-URL weiter.",
    "repository": "eckelt/url-shortener",
    "managed": "oneshot",
    "visibility": "public",
    "asOf": "57e6f538a2a9e58696ea6dda2e9c79635f581cff",
    "specs": [
      "short-links",
      "link-creation",
      "deploy"
    ]
  },
  "containers": [
    {
      "id": "worker",
      "name": "Cloudflare Worker url-shortener",
      "kind": "service",
      "technology": "TypeScript, Cloudflare Workers",
      "summary": "Leitet Kurzlinks weiter und legt über Formular oder API neue Kurzlinks an.",
      "path": "worker/",
      "deployment": "Cloudflare Workers (Route ecke.lt/~* in Zone ecke.lt, Custom Domain kurz.ecke.lt)",
      "visibility": "public",
      "specs": [
        "short-links",
        "link-creation"
      ],
      "evidence": [
        "worker/wrangler.toml:17-24"
      ],
      "interfaces": [
        {
          "id": "short-links",
          "direction": "provides",
          "contractRef": "url-shortener:short-links@1",
          "protocol": "HTTPS Redirect (301)",
          "summary": "GET ecke.lt/~{code} und kurz.ecke.lt/~{code}: 301 auf die Ziel-URL, unbekannter Code → 404",
          "evidence": [
            "worker/src/index.ts:127-134",
            "worker/wrangler.toml:18-20"
          ]
        },
        {
          "id": "shorten-api",
          "direction": "provides",
          "contractRef": "url-shortener:shorten-api@1",
          "protocol": "HTTPS JSON (Bearer-Token)",
          "summary": "POST kurz.ecke.lt/save {url, code?} → {url, code, error}; nur mit Bearer-Token (Secret AUTH_TOKEN)",
          "evidence": [
            "worker/src/index.ts:136-170"
          ]
        },
        {
          "id": "web-ui",
          "direction": "provides",
          "contractRef": "url-shortener:web-ui@1",
          "protocol": "HTTPS HTML",
          "summary": "GET kurz.ecke.lt/: Formular mit URL, optionalem Code und Token, ruft /save auf",
          "evidence": [
            "worker/src/index.ts:41-113",
            "worker/src/index.ts:121-125"
          ]
        },
        {
          "id": "workers-runtime",
          "direction": "consumes",
          "contractRef": "cloudflare-workers:runtime@1",
          "protocol": "Cloudflare Workers",
          "relation": "deploys-to",
          "summary": "Worker url-shortener, Route ecke.lt/~*, Custom Domain kurz.ecke.lt",
          "evidence": [
            "worker/wrangler.toml:1-3",
            "worker/wrangler.toml:17-24"
          ]
        },
        {
          "id": "kv-urls",
          "direction": "consumes",
          "contractRef": "cloudflare-kv:kv@1",
          "protocol": "Workers KV Binding",
          "summary": "Binding URLS: Kurzcode → Ziel-URL; Weiterleitung liest, /save schreibt (Kollision → Zufallscode)",
          "evidence": [
            "worker/wrangler.toml:12-15",
            "worker/src/index.ts:131",
            "worker/src/index.ts:160-166"
          ]
        },
        {
          "id": "bonsai-css",
          "direction": "consumes",
          "contractRef": "unpkg:cdn@1",
          "protocol": "HTTPS CSS",
          "relation": "imports",
          "summary": "Formular lädt bonsai.css@latest von unpkg (im Browser)",
          "evidence": [
            "worker/src/index.ts:46"
          ]
        }
      ]
    },
    {
      "id": "deploy-worker",
      "name": "Worker-Deploy-Workflow",
      "kind": "pipeline",
      "technology": "GitHub Actions",
      "summary": "Prüft die Typen und deployt den Worker bei jedem Push mit Änderungen unter worker/.",
      "path": ".github/workflows/deploy.yml",
      "deployment": "GitHub Actions (ubuntu-latest)",
      "specs": [
        "deploy"
      ],
      "interfaces": [
        {
          "id": "actions",
          "direction": "consumes",
          "contractRef": "github-actions:workflows@1",
          "protocol": "GitHub Actions",
          "summary": "Runner ubuntu-latest, actions/checkout@v7, actions/setup-node@v7 (Node 22)",
          "evidence": [
            ".github/workflows/deploy.yml:1-19"
          ]
        },
        {
          "id": "workers-deploy",
          "direction": "consumes",
          "contractRef": "cloudflare-workers:deploy-api@1",
          "protocol": "Cloudflare API (wrangler deploy)",
          "relation": "writes",
          "perspective": "deployment",
          "summary": "npm run deploy = wrangler deploy; Secrets CLOUDFLARE_API_TOKEN, CLOUDFLARE_ACCOUNT_ID",
          "evidence": [
            ".github/workflows/deploy.yml:21-34"
          ]
        }
      ]
    }
  ]
}
